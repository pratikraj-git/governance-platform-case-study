# ─────────────────────────────────────────────────────────────────────────────
# Governance Platform Case Study — Environment Variables
#
# Copy this file to .env.local and fill in values for local development.
# In production (Vercel), set these in the project's Environment Variables UI.
# ─────────────────────────────────────────────────────────────────────────────

# Optional — set to your portfolio URL to activate the "← Portfolio" back-link
# in the site header and footer. Leave empty to hide it.
NEXT_PUBLIC_PORTFOLIO_URL=https://your-portfolio.com
